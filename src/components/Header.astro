---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url?: string;
  name: string;
  icon?: string;
  image?: string;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  institutions?: Note[];
  links?: Link[];
}

const { title, authors, conference, notes, institutions, links } = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-10 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-6",
    ]}
  >
    <h1 class="my-0 text-5xl font-medium">{title}</h1>
    <div class="author-block">
      <div class="author-list">
        {authors.map((author, index) => (
          <span class="author-entry">
            <span>{author.name}</span>
            {author.notes && <sup>{author.notes.join('')}</sup>}
            {index < authors.length - 1 && <span class="author-comma">,</span>}
          </span>
        ))}
      </div>
      {notes && (
        <div class="author-notes">
          ({notes.map((note, index) => (
            <span>{index > 0 && ', '}<span>{note.symbol}</span> {note.text.toLowerCase()}</span>
          ))})
        </div>
      )}
      {institutions && (
        <div class="author-institutions">
          {institutions.map((institution) => (
            <span><sup>{institution.symbol}</sup> {institution.text}</span>
          ))}
        </div>
      )}
      {authors.some(author => author.institution) && !institutions && (
        <div class="author-institutions">
          {[...new Set(authors.map(author => author.institution).filter(Boolean))].map(institution => <span>{institution}</span>)}
        </div>
      )}
    </div>
    {conference && <div>{conference}</div>}
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => (
            link.url ? <a
              href={link.url}
              class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                hasBackground ? "bg-white hover:bg-zinc-200 text-zinc-800 text-shadow-none shadow-[0_0_8px_rgba(0,0,0,0.6)]" : "bg-zinc-800 text-white hover:bg-black dark:text-zinc-900 dark:hover:bg-zinc-50 dark:bg-zinc-200"
              ]}
            >
              {link.image ? <img src={link.image} alt="" width="22" height="22" class="m-0 h-[22px] w-[22px]" /> : link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a> : <span
              aria-disabled="true"
              title="Link not available yet"
              class="flex flex-row items-center gap-2 rounded-full bg-zinc-200 px-5 py-2 text-lg text-zinc-500 cursor-default"
            >
              {link.image ? <img src={link.image} alt="" width="22" height="22" class="m-0 h-[22px] w-[22px]" /> : link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </span>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  .author-block { display: flex; flex-direction: column; align-items: center; gap: .65rem; width: 100%; }
  .author-list { display: flex; flex-wrap: wrap; justify-content: center; column-gap: .45em; row-gap: .35em; font-size: 1.35rem; line-height: 1.6; color: inherit; }
  .author-entry { display: inline-block; white-space: nowrap; }
  .author-entry sup, .author-institutions sup { position: relative; top: -.4em; vertical-align: baseline; font-size: .7em; line-height: 0; }
  .author-comma { margin-left: .08em; }
  .author-notes { font-size: 1rem; color: #555; }
  .author-institutions { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.5rem; font-size: 1.05rem; line-height: 1.6; color: #555; }
  @media (max-width: 640px) { .author-list { font-size: 1.1rem; } .author-institutions { font-size: .95rem; } }

  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
